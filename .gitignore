dist/
dist-studio/
dist-player/
dist.bak-*
dist-studio.bak-*
build/
.tmp/
mochi-physics-wasm/target/

# Agent scratch state
.agents/
.workbuddy/
.workbuddy-ai/
*.genie

# Cloudflare Wrangler
.wrangler/

# Environment files
.env
.env.*
!.env.example

# Editor and OS
.DS_Store
Thumbs.db
*.suo
*.user
.idea/
.vscode/
*.swp

# Logs and coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/
