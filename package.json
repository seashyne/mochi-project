{
  "name": "mochi-project",
  "private": true,
  "version": "0.1.0",
  "description": "Mochi Project - Independent Web-First Gaming and Creator-Publishing Platform",
  "workspaces": [
    "mochi",
    "mochi-cloud"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "verify:decoupling": "node scripts/verify-decoupling.mjs",
    "verify:assets": "node scripts/verify-asset-hosts.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "verify:standards": "node scripts/check-line-counts.mjs && node scripts/gen-notices.mjs --check && node scripts/verify-decoupling.mjs && node scripts/verify-asset-hosts.mjs",
    "lint:lines": "node scripts/check-line-counts.mjs",
    "verify:browser": "node scripts/verify-browser-cache.mjs",
    "build:wasm": "node scripts/build-physics-wasm.mjs",
    "dev:web": "npm run dev --workspace=mochi",
    "dev:player": "npm run dev:player --workspace=mochi",
    "dev:studio": "npm run dev:studio --workspace=mochi",
    "dev:cloud": "npm run dev --workspace=mochi-cloud",
    "build:player": "npm run build:player --workspace=mochi",
    "build:studio": "npm run build:studio --workspace=mochi",
    "deploy:studio": "npm run deploy:studio --workspace=mochi",
    "mobile:sync": "npm run cap:sync --workspace=mochi",
    "mobile:build:ios": "npm run build:mobile:ios --workspace=mochi",
    "mobile:build:android": "npm run build:mobile:android --workspace=mochi",
    "benchmark:room": "cd mochi-cloud && npx vitest run tests/room_benchmark.test.ts --reporter=verbose",
    "benchmark:client": "node scripts/benchmark-client.mjs",
    "benchmark:kernel": "cd mochi && npx vitest run tests/kernel_benchmark.test.ts --reporter=verbose",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright-core": "^1.60.0"
  }
}
