{
  "name": "mochi",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.player.config.ts",
    "dev:player": "vite --config vite.player.config.ts",
    "dev:studio": "vite --config vite.studio.config.ts",
    "build": "tsc -b && npm run build:player && npm run build:studio",
    "build:player": "vite build --config vite.player.config.ts",
    "build:studio": "vite build --config vite.studio.config.ts",
    "deploy": "npm run build:player && wrangler deploy",
    "deploy:studio": "npm run build:studio && wrangler deploy --config wrangler.studio.jsonc",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --config vite.player.config.ts",
    "preview:studio": "vite preview --config vite.studio.config.ts",
    "test": "vitest run --maxWorkers=4",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "build:mobile:ios": "npm run build && cap sync ios",
    "build:mobile:android": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/screen-orientation": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.0",
    "wasmoon": "^1.16.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.10"
  }
}
